# Copy this file to .env on the Oracle VM and replace the placeholders.
# Use the VM public IP for a no-domain HTTP demo; use your domain for HTTPS later.
APP_BASE_URL=http://REPLACE_WITH_PUBLIC_IP
SHORTLY_DB_USER=shortly
SHORTLY_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Publish only the web entry point. API remains loopback-only on the VM;
# PostgreSQL and Redis are not published to the host.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HOST_PORT=80
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8080
